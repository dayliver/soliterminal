{
  "name": "soliterminal",
  "version": "0.1.0-alpha.1",
  "description": "Klondike solitaire in the terminal with a built-in solver: every deal is winnable, and it tells you the moment a game no longer is.",
  "keywords": [
    "solitaire",
    "klondike",
    "solver",
    "terminal",
    "cli",
    "game",
    "tui"
  ],
  "license": "MIT",
  "author": "dayliver",
  "homepage": "https://github.com/dayliver/soliterminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayliver/soliterminal.git"
  },
  "bugs": {
    "url": "https://github.com/dayliver/soliterminal/issues"
  },
  "type": "module",
  "bin": {
    "soliterminal": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/preview.js",
    "README.md",
    "README.ko.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node src/cli.ts",
    "preview": "node src/preview.ts",
    "peek": "node scripts/peek.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
